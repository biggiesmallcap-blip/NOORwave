{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "pnpm lint:css && pnpm lint:inline-styles",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"lint:inline-styles": "node scripts/lint-inline-styles.mjs",
		"smoke": "node scripts/smoke.mjs",
		"smoke:full": "node scripts/smoke.mjs --phase full",
		"smoke:headed": "node scripts/smoke.mjs --headed",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@napi-rs/canvas": "^1.0.9",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.6.2",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "^5.0.1",
		"jsqr": "^1.4.0",
		"playwright": "^1.63.0",
		"postcss-html": "^2.0.0",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"hls.js": "^1.7.3",
		"qrcode": "^1.5.4"
	},
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.2",
			"esbuild": "^0.28.1",
			"fast-uri": "^3.1.6",
			"js-yaml": "^4.3.2",
			"nanoid": "^3.3.18"
		},
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
