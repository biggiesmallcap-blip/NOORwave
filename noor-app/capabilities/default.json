{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window access for NOORwave's localhost UI.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:3334/**"]
  },
  "permissions": [
    "core:webview:allow-set-webview-zoom",
    "core:event:default",
    "opener:default",
    "updater:default",
    "dialog:default"
  ]
}
