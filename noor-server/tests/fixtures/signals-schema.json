{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noorwave.local/schemas/analytics-signals.json",
  "title": "AnalyticsSignals",
  "description": "Response shape for GET /api/analytics/signals?days=N. Wraps the payload in a top-level `signals` key matching the existing /api/analytics/dashboard envelope convention.",
  "type": "object",
  "required": ["signals"],
  "additionalProperties": false,
  "properties": {
    "signals": {
      "type": "object",
      "required": [
        "window",
        "kpis",
        "tempo",
        "sonic_field",
        "ridgeline",
        "top_tracks",
        "top_artists",
        "top_genres",
        "cohorts",
        "audio_profile"
      ],
      "additionalProperties": false,
      "properties": {
        "window": {
          "type": "object",
          "required": ["days", "started_at", "previous_started_at"],
          "additionalProperties": false,
          "properties": {
            "days": { "type": "integer", "minimum": 1 },
            "started_at": { "type": "string", "format": "date-time" },
            "previous_started_at": { "type": "string", "format": "date-time" }
          }
        },

        "kpis": {
          "type": "object",
          "required": [
            "listened_ms",
            "sessions",
            "completion",
            "skip_rate",
            "daily",
            "hero_stats",
            "sessions_coverage"
          ],
          "additionalProperties": false,
          "properties": {
            "listened_ms": { "$ref": "#/definitions/kpiPairInt" },
            "sessions":    { "$ref": "#/definitions/kpiPairInt" },
            "completion":  { "$ref": "#/definitions/kpiPairFloat" },
            "skip_rate":   { "$ref": "#/definitions/kpiPairFloat" },
            "daily": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["day", "listens", "listened_ms", "completed"],
                "additionalProperties": false,
                "properties": {
                  "day":         { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  "listens":     { "type": "integer", "minimum": 0 },
                  "listened_ms": { "type": "integer", "minimum": 0 },
                  "completed":   { "type": "integer", "minimum": 0 }
                }
              }
            },
            "hero_stats": {
              "type": "object",
              "required": ["peak_hour", "rhythm", "night_share", "morning_share"],
              "additionalProperties": false,
              "properties": {
                "peak_hour":            { "type": ["integer", "null"], "minimum": 0, "maximum": 23 },
                "rhythm":               { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
                "night_share":          { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                "morning_share":        { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                "longest_session_ms":   { "type": ["integer", "null"], "minimum": 0 },
                "distinct_tracks":      { "type": ["integer", "null"], "minimum": 0 }
              }
            },
            "sessions_coverage": {
              "type": "object",
              "description": "Session-tracking coverage. tracked = listens with non-null session_id; untracked = listens before MIGRATION_023 (no session_id).",
              "required": ["tracked", "untracked"],
              "additionalProperties": false,
              "properties": {
                "tracked":   { "type": "integer", "minimum": 0 },
                "untracked": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },

        "tempo": {
          "type": "object",
          "required": ["bucket_axis", "rows", "stats", "coverage", "ridge_amp_max"],
          "additionalProperties": false,
          "properties": {
            "bucket_axis": {
              "type": "object",
              "required": ["min", "max", "step"],
              "additionalProperties": false,
              "properties": {
                "min":  { "type": "integer", "const": 60 },
                "max":  { "type": "integer", "const": 200 },
                "step": { "type": "integer", "const": 4 }
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "granularity", "buckets"],
                "additionalProperties": false,
                "properties": {
                  "label":       { "type": "string", "minLength": 1 },
                  "granularity": { "type": "string", "enum": ["day", "week", "month"] },
                  "buckets": {
                    "type": "array",
                    "minItems": 36,
                    "maxItems": 36,
                    "items": {
                      "type": "object",
                      "required": ["bucket", "listens"],
                      "additionalProperties": false,
                      "properties": {
                        "bucket":  { "type": "integer", "minimum": 60, "maximum": 196 },
                        "listens": { "type": "integer", "minimum": 0 }
                      }
                    }
                  }
                }
              }
            },
            "stats": {
              "type": "object",
              "required": ["median", "mode", "sigma"],
              "additionalProperties": false,
              "properties": {
                "median": { "type": ["number", "null"], "minimum": 60, "maximum": 200 },
                "mode":   { "type": ["number", "null"], "minimum": 60, "maximum": 200 },
                "sigma":  { "type": ["number", "null"], "minimum": 0 }
              }
            },
            "coverage": { "$ref": "#/definitions/coverage" },
            "ridge_amp_max": { "type": "number", "minimum": 0 }
          }
        },

        "sonic_field": {
          "type": "object",
          "required": ["tracks", "total", "coverage"],
          "additionalProperties": false,
          "properties": {
            "tracks": {
              "type": "array",
              "maxItems": 1500,
              "items": {
                "type": "object",
                "required": ["track_id", "title", "artist_name", "album", "artwork_path", "file_path", "e", "d", "bpm", "listens"],
                "additionalProperties": false,
                "properties": {
                  "track_id":     { "type": "integer" },
                  "title":        { "type": "string" },
                  "artist_name":  { "type": ["string", "null"] },
                  "album":        { "type": ["string", "null"] },
                  "artwork_path": { "type": ["string", "null"] },
                  "file_path":    { "type": ["string", "null"] },
                  "e":            { "type": "number", "minimum": 0, "maximum": 1 },
                  "d":            { "type": "number", "minimum": 0, "maximum": 1 },
                  "bpm":          { "type": "number", "minimum": 60, "maximum": 200 },
                  "listens":      { "type": "integer", "minimum": 1 }
                }
              }
            },
            "total":    { "type": "integer", "minimum": 0 },
            "coverage": { "$ref": "#/definitions/coverage" }
          }
        },

        "ridgeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "hourly"],
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "hourly": {
                "type": "array",
                "minItems": 24,
                "maxItems": 24,
                "items": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },

        "top_tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["track_id", "title", "artist_name", "album_title", "artwork_url", "listens", "completed_listens", "total_listened_ms"],
            "additionalProperties": false,
            "properties": {
              "track_id":          { "type": "integer" },
              "title":             { "type": "string" },
              "artist_name":       { "type": ["string", "null"] },
              "album_title":       { "type": ["string", "null"] },
              "artwork_url":       { "type": ["string", "null"] },
              "listens":           { "type": "integer", "minimum": 0 },
              "completed_listens": { "type": "integer", "minimum": 0 },
              "total_listened_ms": { "type": "integer", "minimum": 0 }
            }
          }
        },

        "top_artists": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artist_id", "artist_name", "listens", "completed_listens", "unique_tracks", "total_listened_ms"],
            "additionalProperties": false,
            "properties": {
              "artist_id":         { "type": "integer" },
              "artist_name":       { "type": "string" },
              "listens":           { "type": "integer", "minimum": 0 },
              "completed_listens": { "type": "integer", "minimum": 0 },
              "unique_tracks":     { "type": "integer", "minimum": 0 },
              "total_listened_ms": { "type": "integer", "minimum": 0 }
            }
          }
        },

        "top_genres": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["genre_name", "listens"],
            "additionalProperties": false,
            "properties": {
              "genre_name": { "type": "string" },
              "listens":    { "type": "integer", "minimum": 0 }
            }
          }
        },

        "cohorts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["key", "label", "tracks", "listened_ms", "sessions", "completion", "skip_rate", "new_artists", "repeat_rate"],
            "additionalProperties": false,
            "properties": {
              "key":         { "type": "string", "enum": ["new_this_month", "established", "deep_cuts"] },
              "label":       { "type": "string" },
              "tracks":      { "type": "integer", "minimum": 0 },
              "listened_ms": { "type": "integer", "minimum": 0 },
              "sessions":    { "type": "integer", "minimum": 0 },
              "completion":  { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "skip_rate":   { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "new_artists": { "type": "integer", "minimum": 0 },
              "repeat_rate": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        },

        "audio_profile": {
          "type": "object",
          "required": ["dynamic_range_dr", "loudness_lufs", "bass_tilt", "treble_tilt", "coverage"],
          "additionalProperties": false,
          "properties": {
            "dynamic_range_dr": { "type": ["number", "null"], "minimum": 0 },
            "loudness_lufs":    { "type": ["number", "null"] },
            "bass_tilt":        { "type": ["number", "null"], "minimum": -6, "maximum": 6 },
            "treble_tilt":      { "type": ["number", "null"], "minimum": -6, "maximum": 6 },
            "coverage":         { "$ref": "#/definitions/coverage" }
          }
        }
      }
    }
  },

  "definitions": {
    "kpiPairInt": {
      "type": "object",
      "required": ["current", "previous"],
      "additionalProperties": false,
      "properties": {
        "current":  { "type": "integer", "minimum": 0 },
        "previous": { "type": "integer", "minimum": 0 }
      }
    },
    "kpiPairFloat": {
      "type": "object",
      "required": ["current", "previous"],
      "additionalProperties": false,
      "properties": {
        "current":  { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "previous": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["analyzed", "total_listened"],
      "additionalProperties": false,
      "properties": {
        "analyzed":       { "type": "integer", "minimum": 0 },
        "total_listened": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
